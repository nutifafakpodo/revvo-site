# Where the product apps live. Links on the site point here.
# Defaults: /app, /business, /admin (relative, for a deployment beside the apps).
VITE_CONSUMER_APP_URL=https://app.example.com/app
VITE_BUSINESS_APP_URL=https://app.example.com/business
VITE_ADMIN_APP_URL=https://app.example.com/admin

# Pilot sign-up form. Set ONE of these:
#  - a JSON POST endpoint (e.g. Formspree, or your own API), or
#  - a contact email; the form then opens a pre-filled mailto: message.
# VITE_PILOT_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
VITE_CONTACT_EMAIL=hello@example.com
